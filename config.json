{
    "name": "compact_supcon",
    "seed": 42,
    "n_gpu": 1,
    "device": "auto",
    "arch": {
        "type": "CompactAutoEncoder",
        "args": {
            "base_channels": 8,
            "latent_dim": 32,
            "decoder_type": "joint",
            "decoder_channels": 8,
            "decoder_blocks": 1
        }
    },
    "dataset": {
        "fonts_dir": "data/fonts",
        "annotation_file": "data/fonts.csv",
        "font_size": 64,
        "layout_engine": "raqm",
        "corpus_files": [
            "data/corpus/shahnameh.txt",
            "data/corpus/words.txt"
        ],
        "text_length": [
            3,
            8
        ],
        "number_ratio": 0.1,
        "text_image_dims": [
            128,
            32
        ],
        "font_fingerprint_dims": [
            32,
            32
        ],
        "render_scale": 2,
        "cache_dir": "data/cache"
    },
    "data_loader": {
        "args": {
            "random_seed": 42,
            "total_samples": 1000000,
            "random_augmentations": true,
            "validation_augmentations": true,
            "validation_split": 0.1,
            "batch_fonts": 32,
            "batch_samples_per_font": 4,
            "batch_size": 128,
            "num_workers": 12,
            "pin_memory": true
        }
    },
    "clustering_data_loader": {
        "args": {
            "random_seed": 123,
            "samples_per_font": 100,
            "random_augmentations": true,
            "batch_size": 128,
            "num_workers": 12,
            "pin_memory": true
        }
    },
    "optimizer": {
        "type": "Adam",
        "args": {
            "lr": 0.005,
            "weight_decay": 0,
            "amsgrad": true
        }
    },
    "loss": "l1_loss",
    "contrastive_loss": {
        "weight": 0.5,
        "temperature": 0.1
    },
    "style_head": {
        "weight": 0.2,
        "detach": false
    },
    "adversarial_loss": {
        "weight": 0.0,
        "start_epoch": 5,
        "lr": 0.0002,
        "discriminator_channels": 32
    },
    "metrics": [],
    "lr_scheduler": {
        "type": "StepLR",
        "args": {
            "step_size": 10,
            "gamma": 0.1
        }
    },
    "trainer": {
        "epochs": 200,
        "save_dir": "saved/",
        "save_period": 1,
        "keep_last_checkpoints": 5,
        "verbosity": 2,
        "monitor": "max val_top1_acc",
        "early_stop": 10,
        "topk": [
            1,
            5
        ],
        "tensorboard": true,
        "figure_period": 1
    }
}
